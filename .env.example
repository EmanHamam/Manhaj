# =============================================================================
# Manhaj - environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
# Every variable is documented in README.md > Configuration.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
MANHAJ__PublicBaseUrl=http://localhost:8080

# --- Database (Postgres + pgvector) ------------------------------------------
POSTGRES_USER=manhaj
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=manhaj
POSTGRES_PORT=5432
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=manhaj;Username=manhaj;Password=change-me-locally

# --- LLM provider chain (ordered fallback, see docs/adr/0002) -----------------
MANHAJ__Llm__Chain__0=gemini-flash
MANHAJ__Llm__Chain__1=gemini-flash-lite
MANHAJ__Llm__Chain__2=ollama-local

# Google AI Studio free tier - key from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyDWnWykp_1TAOhHXydt0zbRuX6L-vCoFao
MANHAJ__Llm__Gemini__BaseUrl=https://generativelanguage.googleapis.com/v1beta
MANHAJ__Llm__Gemini__CompletionModel=gemini-2.0-flash
MANHAJ__Llm__Gemini__LiteModel=gemini-2.0-flash-lite
MANHAJ__Llm__Gemini__EmbeddingModel=text-embedding-004

# Ollama - fully local, no key. Start with: docker compose --profile local up
MANHAJ__Llm__Ollama__BaseUrl=http://ollama:11434
MANHAJ__Llm__Ollama__CompletionModel=qwen2.5:7b-instruct
MANHAJ__Llm__Ollama__EmbeddingModel=nomic-embed-text

# --- Embeddings (dimension persisted per chunk; change requires re-index) -----
MANHAJ__Embedding__Dimensions=768

# --- Retrieval ---------------------------------------------------------------
MANHAJ__Retrieval__DenseTopK=20
MANHAJ__Retrieval__KeywordTopK=20
MANHAJ__Retrieval__RrfK=60
MANHAJ__Retrieval__FinalTopK=8
MANHAJ__Retrieval__MinEvidenceScore=0.35

# --- Orchestration controls (FR-5) -------------------------------------------
MANHAJ__Orchestration__MaxIterations=12
MANHAJ__Orchestration__StepTimeoutSeconds=60
MANHAJ__Orchestration__MaxRetriesPerStep=3

# --- Budgets (OWASP LLM: unbounded consumption) ------------------------------
MANHAJ__Budget__MaxTokensPerRun=120000
MANHAJ__Budget__MaxTokensPerUserPerDay=500000
MANHAJ__Budget__MaxConcurrentRunsPerUser=2

# --- Review queue SLA in minutes, by priority (T5) ---------------------------
MANHAJ__Review__Sla__P0=60
MANHAJ__Review__Sla__P1=240
MANHAJ__Review__Sla__P2=1440
MANHAJ__Review__Sla__P3=4320
MANHAJ__Review__EscalationSweepSeconds=60

# --- Auth (generate key with: openssl rand -base64 48) -----------------------
MANHAJ__Jwt__SigningKey=LWBjnyAe0YDENURhcThtLCAvI2xd2VtmbuYIMAB25xI
MANHAJ__Jwt__Issuer=manhaj
MANHAJ__Jwt__Audience=manhaj-web
MANHAJ__Jwt__LifetimeMinutes=120

# --- Seeded demo accounts (development only) ---------------------------------
MANHAJ__Seed__DesignerEmail=designer@manhaj.local
MANHAJ__Seed__DesignerPassword=Designer!2345
MANHAJ__Seed__InstructorEmail=instructor@manhaj.local
MANHAJ__Seed__InstructorPassword=Instructor!2345

# --- Frontend ----------------------------------------------------------------
NG_APP_API_BASE_URL=http://localhost:8080
